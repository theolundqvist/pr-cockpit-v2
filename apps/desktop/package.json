{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && tsc --noEmit",
    "svelte-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . && prettier --check .",
    "test": "vitest run",
    "test:smoke": "bash -lc 'if command -v xvfb-run >/dev/null 2>&1; then xvfb-run -a playwright test tests/smoke.spec.ts; else playwright test tests/smoke.spec.ts; fi'",
    "test:airplane": "bash -lc 'if command -v xvfb-run >/dev/null 2>&1; then xvfb-run -a playwright test playwright/airplane.spec.ts; else playwright test playwright/airplane.spec.ts; fi'",
    "bench": "node ../../tools/perf-bench/run-all.mjs",
    "corpus": "node ../../tools/markdown-corpus/score.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@primer/css": "^22.1.1",
    "@primer/octicons": "^19.25.0",
    "@primer/primitives": "^11.9.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.60.1",
    "@tanstack/svelte-virtual": "^3.13.24",
    "@tauri-apps/api": "2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "dompurify": "^3.4.3",
    "svelte": "5",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "web-tree-sitter": "^0.26.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "svelte-check": "^4.4.8",
    "svelte-eslint-parser": "^1.6.1",
    "vitest": "^4.1.6"
  }
}
