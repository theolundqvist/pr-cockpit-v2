{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for scaffolded desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "os:default",
    "clipboard-manager:default",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/blobs/**/*" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/blobs/**/*" }]
    }
  ]
}
